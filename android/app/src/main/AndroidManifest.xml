<?xml version="1.0" encoding="utf-8"?>
<!--
  Ghost Android client manifest.
  No GMS/Firebase: F-Droid compatible. Tor + IMAP/SMTP + OpenPGP only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network for Tor bootstrap and mail over Tor SOCKS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keep Tor running while the app syncs mail. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Notifications for new mail. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".GhostApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Ghost"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tor foreground service: keeps the onion connection alive. -->
        <service
            android:name=".tor.TorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
